# Claude API key — powers per-question scoring and top-10 curation.
# Without it the app still works; questions just land unscored.
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-5)
# RANKER_MODEL=claude-opus-5

# Shared secret for the host dashboard: /host?key=<HOST_KEY>
# If unset, /host is open (fine for local dev, set it before deploying).
HOST_KEY=

# Upstash Redis (add the Upstash integration in the Vercel dashboard and
# these get injected automatically — either naming works).
# Without Redis the app falls back to in-memory storage: fine locally,
# NOT reliable on Vercel (each serverless instance has its own memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
